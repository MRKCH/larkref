{
  "manifest_version": "0.3",
  "name": "larkref",
  "display_name": "LarkRef（飞书引用）",
  "version": "1.1.0",
  "description": "在 Claude 中选择飞书群聊、联系人、云文档和多维表格，读取为本轮参考资料。",
  "author": { "name": "MRKCH" },
  "repository": { "type": "git", "url": "https://github.com/MRKCH/larkref" },
  "icon": "assets/feishu.png",
  "server": {
    "type": "node",
    "entry_point": "server.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server.mjs", "--claude-desktop"]
    }
  },
  "tools": [
    { "name": "search_mentions", "description": "搜索群聊、联系人和文档，返回名称和引用。" },
    { "name": "read_context", "description": "读取选中引用的消息、文档或数据表，支持翻页。" }
  ],
  "prompts_generated": true
}
